# Default 1, after: same pod, same cache, heap sized from what non-heap memory actually needs.
# 70 is a starting point: check that cgroup_memory_usage_bytes stays well under the limit at peak.
# Load: k6 -e PROFILE=heap
SCENARIO=d1-heap-after
APP_CPUS=2
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70

SPRING_CACHE_CAFFEINE_SPEC=maximumSize=200000,recordStats
