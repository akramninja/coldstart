# Default 5, before: what @EnableCaching gives an application with no cache provider.
# Caffeine is on this lab's classpath, so the simple cache is selected explicitly: it is the same
# ConcurrentMapCacheManager Spring Boot falls back to when it finds no provider.
# Load: k6 -e PROFILE=cache
SCENARIO=d5-cache-before
APP_CPUS=2
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70

SPRING_CACHE_TYPE=simple
