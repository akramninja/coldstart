# Default 4, after: a bounded queue. When it is full, confirmations are recorded as DEFERRED in the
# database instead of piling up in the heap.
# Load: k6 -e PROFILE=async
SCENARIO=d4-async-after
APP_CPUS=2
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70

SPRING_TASK_EXECUTION_POOL_CORE_SIZE=8
SPRING_TASK_EXECUTION_POOL_MAX_SIZE=16
SPRING_TASK_EXECUTION_POOL_QUEUE_CAPACITY=500
