# Default 3, after: open-in-view off, order loaded with one fetch-join query in a read-only
# transaction. The connection is back in the pool before the carrier call.
# Load: k6 -e PROFILE=osiv
SCENARIO=d3-osiv-after
APP_CPUS=2
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70

SPRING_JPA_OPEN_IN_VIEW=false
COLDSTART_ORDERS_READ_MODEL=projection
