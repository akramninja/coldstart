# Default 2, before: a 1-CPU pod with Tomcat's 200 threads. Below 2 CPUs, the JVM also picks SerialGC.
# Every scenario except Default 1 pins the heap at 70%, so memory never muddies the result.
# Load: k6 -e PROFILE=threads (CPU-bound quotes)
SCENARIO=d2-threads-before
APP_CPUS=1
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70
