# Default 2, experiment: keep the 1-CPU pod, cap Tomcat so overload is refused fast instead of
# queued inside a throttled pod. Not a recommendation until measured against d2-threads-before at
# the same steps: dropped requests, failed requests and client p99.
# Load: k6 -e PROFILE=threads
SCENARIO=d2-threads-capped
APP_CPUS=1
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70

SERVER_TOMCAT_THREADS_MAX=16
SERVER_TOMCAT_ACCEPT_COUNT=50
