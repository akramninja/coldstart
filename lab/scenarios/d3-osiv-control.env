# Default 3, control: the fix's fetch-join query, but open-in-view left on.
# Separates the two changes: fewer queries versus giving the connection back.
# OpenInViewConnectionTests shows this still holds the connection during the carrier call.
# Load: k6 -e PROFILE=osiv
SCENARIO=d3-osiv-control
APP_CPUS=2
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70

COLDSTART_ORDERS_READ_MODEL=projection
