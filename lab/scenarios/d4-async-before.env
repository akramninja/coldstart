# Default 4, before: Spring Boot's task executor, 8 threads and an unbounded queue.
# 100 orders/s in, about 40 confirmations/s out (8 threads x 200 ms): the backlog grows in the heap.
# Load: k6 -e PROFILE=async
SCENARIO=d4-async-before
APP_CPUS=2
APP_MEMORY=2g
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=70
